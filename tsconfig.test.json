{
  "extends": "./tsconfig.node.json",
  "include": [
    "src/main/**/*.test.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "src/types/**/*"
  ],
  "ts-node": { "experimentalResolver": true, "experimentalSpecifierResolution": "node" },
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "electron-vite/node"]
  }
}
